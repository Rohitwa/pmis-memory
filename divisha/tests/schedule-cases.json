    { "name": "every other day", "s": { "repeat": "daily", "every": 2, "date": "2026-11-01", "times": ["08:00"] },
      "days": { "2026-11-01": ["2026-11-01 08:00"], "2026-11-02": [], "2026-11-03": ["2026-11-03 08:00"], "2026-12-01": ["2026-12-01 08:00"] } },
    { "name": "weekly on Mon, Wed, Fri", "s": { "repeat": "weekly", "weekdays": [1, 3, 5], "date": "2026-11-01", "times": ["19:30"] },
      "days": { "2026-11-01": [], "2026-11-02": ["2026-11-02 19:30"], "2026-11-04": ["2026-11-04 19:30"], "2026-11-05": [], "2026-11-06": ["2026-11-06 19:30"] } },
    { "name": "weekly with no days chosen uses the start day", "s": { "repeat": "weekly", "date": "2026-11-01" },
      "days": { "2026-11-08": ["2026-11-08"], "2026-11-09": [] } },
    { "name": "monthly on the 31st falls on short months' last day", "s": { "repeat": "monthly", "date": "2026-01-31", "times": ["10:00"] },
      "days": { "2026-02-28": ["2026-02-28 10:00"], "2026-03-31": ["2026-03-31 10:00"], "2026-04-30": ["2026-04-30 10:00"], "2026-04-29": [] } },
    { "name": "paused shows nothing", "s": { "repeat": "daily", "date": "2026-11-01", "paused": true, "times": ["09:00"] },
      "days": { "2026-11-02": [] } },
    { "name": "an older item with a single time", "s": { "repeat": "daily", "date": "2026-11-01", "time": "09:00" },
      "days": { "2026-11-02": ["2026-11-02 09:00"] } }
